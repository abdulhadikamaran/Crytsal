{
  "manifest_version": 3,
  "name": "Crystal: AI Corrector",
  "version": "1.1.0",
  "icons": {
    "16": "batman-logo-png_seeklogo-17070.png",
    "48": "batman-logo-png_seeklogo-17070.png",
    "128": "batman-logo-png_seeklogo-17070.png"
  },
  "action": {
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/index.ts-D9aqtBlg.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "notifications",
    "alarms"
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "batman-logo-png_seeklogo-17070.png",
        "public/batman-logo-png_seeklogo-17070.png",
        "assets/index.ts-D9aqtBlg.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
